# Copiez ce fichier en .env.local et remplissez avec les valeurs de
# Supabase > Project Settings > API (ou « Connect » en haut du tableau de bord).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique : « publishable key » (sb_publishable_...) ou ancienne « anon key ».
# Jamais la clé secrète / service_role.
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
